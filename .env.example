# ==========================================
# 🆓 100% FREE LLM PROVIDERS (Pick ANY ONE)
# ==========================================

# Option 1: Google Gemini (Recommended Free Tier - 15 RPM, 1,500 Requests/Day)
# Get key in 30 seconds (no credit card): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 2: Groq (Ultra-Fast Free Tier - Llama 3.3 70B)
# Get key in 30 seconds: https://console.groq.com/keys
GROQ_API_KEY=

# Option 3: Anthropic Claude (Paid)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# ==========================================
# 🔍 SEARCH PROVIDERS
# ==========================================
# DuckDuckGo is built-in & 100% FREE (No key needed!)
TAVILY_API_KEY=

# ==========================================
# ⚙️ SYSTEM SETTINGS
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///./contentmaker.db
MAX_REVISION_LOOPS=3
CRITIC_MIN_OVERALL_SCORE=4.0
CRITIC_MIN_INDIVIDUAL_SCORE=3.0
PORT=8000
HOST=0.0.0.0
